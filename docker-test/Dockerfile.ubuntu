FROM ubuntu:22.04

# 必要なパッケージをインストール
RUN apt-get update && apt-get install -y \
    sudo \
    systemd \
    bash \
    coreutils \
    findutils \
    procps \
    net-tools \
    iproute2 \
    iptables \
    lsof \
    vim \
    curl \
    wget \
    openssh-server \
    cron \
    && rm -rf /var/lib/apt/lists/*

# テスト用のダミーデータ作成
RUN mkdir -p /var/log && \
    echo "Test log entry" > /var/log/test.log && \
    useradd -m -s /bin/bash testuser && \
    echo "testuser:password" | chpasswd

# LDIR-Toolkitをコピー
COPY ldir-toolkit /opt/ldir-toolkit
RUN chmod +x /opt/ldir-toolkit/ldir-collect.sh && \
    chmod +x /opt/ldir-toolkit/modules/*.sh && \
    chmod +x /opt/ldir-toolkit/lib/*.sh

# 作業ディレクトリ
WORKDIR /opt/ldir-toolkit

# デフォルトコマンド
CMD ["/bin/bash"]
