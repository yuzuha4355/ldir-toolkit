FROM centos:7

# CentOS 7 は EOL のため、vault.centos.org にリポジトリを変更
RUN sed -i 's/mirrorlist/#mirrorlist/g' /etc/yum.repos.d/CentOS-*.repo && \
    sed -i 's|#baseurl=http://mirror.centos.org|baseurl=http://vault.centos.org|g' /etc/yum.repos.d/CentOS-*.repo

# 必要なパッケージをインストール
RUN yum install -y \
    sudo \
    systemd \
    bash \
    coreutils \
    findutils \
    procps-ng \
    net-tools \
    iproute \
    iptables \
    lsof \
    vim \
    curl \
    wget \
    openssh-server \
    cronie \
    && yum clean all

# テスト用ログファイル作成
RUN mkdir -p /var/log && \
    echo "CentOS 7 test log" > /var/log/test.log && \
    echo "root:x:0:0:root:/root:/bin/bash" >> /etc/passwd

# LDIR-Toolkitをコピー
COPY ldir-toolkit /opt/ldir-toolkit
RUN chmod +x /opt/ldir-toolkit/ldir-collect.sh && \
    chmod +x /opt/ldir-toolkit/modules/*.sh && \
    chmod +x /opt/ldir-toolkit/lib/*.sh

# 出力ディレクトリ作成
RUN mkdir -p /output

WORKDIR /opt/ldir-toolkit

CMD ["/bin/bash"]
